# HTTP Basic password. Never printed. HARBOR_PASSWORD_FILE may replace this.
HARBOR_PASSWORD=

# Username. Robot accounts look like robot$project+name.
HARBOR_USERNAME=admin

# Self-hosted origin only. No userinfo, query, hash, or path. The client adds /api/v2.0.
HARBOR_URL=http://127.0.0.1:18080

# Literal true is required to execute writes. Any other value is a dry-run.
HARBOR_ALLOW_WRITES=false

# Contact embedded in the User-Agent. Must not be the password.
HARBOR_CONTACT=you@example.com

# Local sliding window. Cache hits do not spend it.
HARBOR_PER_MINUTE=30

# Cache TTL in seconds. 0 disables caching.
HARBOR_CACHE_TTL_SEC=60

# Upstream timeout in milliseconds.
HARBOR_TIMEOUT_MS=20000

# stdio (default) or http. --http on the command line forces http.
MCP_TRANSPORT=stdio
PORT=3000
